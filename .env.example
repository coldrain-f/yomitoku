# Docker Compose reads these values when it starts the local backend stack.
POSTGRES_DB=yomitoku
POSTGRES_USER=yomitoku
POSTGRES_PASSWORD=change-this-for-a-real-environment
POSTGRES_PORT=5433

APP_ENV=development
CORS_ALLOWED_ORIGINS=http://localhost:5173
API_PORT=8001

# Keep "stub" until a real provider key is configured. The stub runs the full
# generation and validation workflow without making a billable model request.
GENERATION_PROVIDER=stub
GENERATOR_MODEL=claude-fable-5
ANSWER_VALIDATOR_MODEL=claude-fable-5
QUALITY_VALIDATOR_MODEL=claude-fable-5
ANTHROPIC_API_KEY=

# Development-only identity used by protected API examples.
DEV_ADMIN_ID=00000000-0000-0000-0000-000000000001
