# Docker Compose reads these values when it starts the local backend stack.
POSTGRES_DB=yomitoku
POSTGRES_USER=yomitoku
POSTGRES_PASSWORD=change-this-for-a-real-environment
POSTGRES_PORT=5433

APP_ENV=development
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
API_PORT=8001

# Vite uses the API URL at build time. The development headers below are never
# sent by a production build.
VITE_API_BASE_URL=http://localhost:8001/api/v1
VITE_DEV_ROLE=admin
VITE_DEV_USER_ID=00000000-0000-0000-0000-000000000001

# Google Identity Services configuration. Create a Web OAuth client in Google
# Cloud and register GitHub Pages plus the local Vite origins before setting it.
GOOGLE_OAUTH_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=
AUTH_JWT_SECRET=
AUTH_JWT_ISSUER=yomitoku-api
AUTH_JWT_AUDIENCE=yomitoku-web
AUTH_ACCESS_TOKEN_TTL_SECONDS=28800
ADMIN_GOOGLE_EMAILS=

# Keep "stub" until a real provider key is configured. The stub runs the full
# generation and validation workflow without making a billable model request.
GENERATION_PROVIDER=stub
GENERATOR_MODEL=claude-fable-5
ANSWER_VALIDATOR_MODEL=claude-fable-5
QUALITY_VALIDATOR_MODEL=claude-fable-5
MAX_GENERATION_REVISIONS=2
MAX_GENERATION_OUTPUT_RETRIES=1
# Comma-separated allowlist exposed to admin model selectors. Leave empty to
# use the distinct models configured above.
GENERATION_MODEL_OPTIONS=
ANTHROPIC_API_KEY=

# Optional. Keep this server-only key out of frontend environment variables.
# DeepL API Free keys end in :fx and use the Free endpoint automatically.
DEEPL_API_KEY=

# Development-only identity used by protected API examples.
DEV_ADMIN_ID=00000000-0000-0000-0000-000000000001
