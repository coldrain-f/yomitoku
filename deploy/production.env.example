# Copy to .env.production on the Linux server. Do not commit that file.
API_DOMAIN=api.example.com
ACME_EMAIL=admin@example.com

POSTGRES_DB=yomitoku
POSTGRES_USER=yomitoku
POSTGRES_PASSWORD=replace-with-a-long-random-database-password

APP_ENV=production
CORS_ALLOWED_ORIGINS=https://coldrain-f.github.io
API_WORKERS=2
# Only used with docker-compose.host-caddy.yml. Bound to localhost, never public.
API_HOST_PORT=8002

GOOGLE_OAUTH_CLIENT_ID=replace-with-your-client-id.apps.googleusercontent.com
AUTH_JWT_SECRET=replace-with-a-32-character-or-longer-random-server-secret
AUTH_JWT_ISSUER=yomitoku-api
AUTH_JWT_AUDIENCE=yomitoku-web
AUTH_ACCESS_TOKEN_TTL_SECONDS=28800
ADMIN_GOOGLE_EMAILS=admin@example.com

# Keep stub until the AI integration work is deliberately enabled.
GENERATION_PROVIDER=stub
GENERATOR_MODEL=claude-fable-5-1
ANSWER_VALIDATOR_MODEL=claude-fable-5-1
QUALITY_VALIDATOR_MODEL=claude-fable-5-1
# Comma-separated model allowlist for the administrator's generation selectors.
GENERATION_MODEL_OPTIONS=claude-fable-5-1,claude-fable-5,claude-opus-5,claude-sonnet-5,claude-haiku-4-5
ANTHROPIC_API_KEY=
MAX_GENERATION_REVISIONS=1
MAX_GENERATION_OUTPUT_RETRIES=1
WORKER_POLL_INTERVAL_SECONDS=1.5
GENERATION_REQUEST_TIMEOUT_SECONDS=180
GENERATION_JOB_TIMEOUT_SECONDS=900
WORKER_LEASE_SECONDS=90
